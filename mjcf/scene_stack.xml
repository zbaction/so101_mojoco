<mujoco model="so101_pick_scene_stacked">
  <!-- SO-101 arm (project-local copy of Simulation/SO101/so101_new_calib_camera.xml,
       with a wrist camera added on the wrist_camera body) -->
  <!-- Stacked layout: red, green, blue cubes form one tower at (0.215, -0.045).
       Generated by stack_cubes.py --rebuild. -->
  <include file="so101_arm.xml"/>

  <option timestep="0.002" integrator="implicitfast" cone="elliptic" impratio="10"/>

  <visual>
    <headlight diffuse="0.55 0.55 0.55" ambient="0.32 0.32 0.32" specular="0.1 0.1 0.1"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="150" elevation="-22" offwidth="1280" offheight="960"/>
    <map znear="0.003" zfar="8"/>
  </visual>

  <default>
    <default class="table">
      <geom type="box" material="tabletop" friction="0.9 0.02 0.001" solref="0.005 1"/>
    </default>
    <default class="cube">
      <geom type="box" size="0.01 0.01 0.01" mass="0.02"
            friction="1.0 0.02 0.001" solref="0.004 1" solimp="0.9 0.96 0.001" condim="4"/>
      <joint type="free" damping="0.0005" armature="0"/>
    </default>
    <default class="bin">
      <geom type="box" material="binmat" friction="0.8 0.02 0.001" solref="0.005 1" mass="0.05"/>
    </default>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.35 0.5 0.7" rgb2="0.08 0.10 0.14"
             width="512" height="3072"/>
    <texture type="2d" name="wood" builtin="checker" mark="edge" rgb1="0.62 0.44 0.26"
             rgb2="0.55 0.38 0.22" markrgb="0.45 0.30 0.17" width="256" height="256"/>
    <material name="tabletop" texture="wood" texuniform="true" texrepeat="6 6" reflectance="0.08"
              specular="0.15" shininess="0.25"/>
    <material name="binmat" rgba="0.25 0.25 0.28 1" specular="0.3" shininess="0.4"/>
    <material name="mat_red" rgba="0.9 0.12 0.12 1" specular="0.45" shininess="0.6" reflectance="0.05"/>
    <material name="mat_green" rgba="0.12 0.75 0.20 1" specular="0.45" shininess="0.6" reflectance="0.05"/>
    <material name="mat_blue" rgba="0.15 0.30 0.90 1" specular="0.45" shininess="0.6" reflectance="0.05"/>
  </asset>

  <worldbody>
    <light pos="0.25 0 1.30" dir="0 0 -1" directional="true" diffuse="0.55 0.55 0.55"
           specular="0.1 0.1 0.1" castshadow="true"/>
    <light pos="0.05 -0.45 0.55" dir="0.2 0.5 -0.6" directional="true"
           diffuse="0.20 0.20 0.22" specular="0 0 0"/>

    <!-- ===== 桌面 (table): top surface at z = 0 ===== -->
    <body name="table" pos="0.18 0.00 -0.02">
      <geom name="table_top" class="table" size="0.30 0.30 0.02" contype="1" conaffinity="1"/>
    </body>

    <!-- ===== 场景摄像头 (fixed scene camera) ===== -->
    <camera name="scene_cam" pos="0.5360 -0.3660 0.4110"
            quat="0.827687 0.446709 0.161333 0.298926"
            fovy="40" resolution="640 480"/>

    <!-- ===== red cube (stack level 0) ===== -->
    <body name="cube_red" pos="0.2150 -0.0450 0.0102" euler="0 0 0.100">
      <freejoint name="joint_cube_red"/>
      <geom name="geom_cube_red" class="cube" material="mat_red"/>
    </body>

    <!-- ===== green cube (stack level 1) ===== -->
    <body name="cube_green" pos="0.2150 -0.0450 0.0304" euler="0 0 -0.060">
      <freejoint name="joint_cube_green"/>
      <geom name="geom_cube_green" class="cube" material="mat_green"/>
    </body>

    <!-- ===== blue cube (stack level 2) ===== -->
    <body name="cube_blue" pos="0.2150 -0.0450 0.0506" euler="0 0 0.220">
      <freejoint name="joint_cube_blue"/>
      <geom name="geom_cube_blue" class="cube" material="mat_blue"/>
    </body>

    <!-- ===== 目标收纳盒 (target bin) ===== -->
    <body name="bin" pos="0.2150 0.1350 0.0000">
      <geom name="bin_floor" class="bin" pos="0 0 0.0025" size="0.065 0.065 0.0025"/>
      <geom name="bin_wall_py" class="bin" pos="0 0.0625 0.0175" size="0.065 0.0025 0.0175"/>
      <geom name="bin_wall_ny" class="bin" pos="0 -0.0625 0.0175" size="0.065 0.0025 0.0175"/>
      <geom name="bin_wall_px" class="bin" pos="0.0625 0 0.0175" size="0.0025 0.065 0.0175"/>
      <geom name="bin_wall_nx" class="bin" pos="-0.0625 0 0.0175" size="0.0025 0.065 0.0175"/>
      <site name="bin_center" pos="0 0 0.03" rgba="1 1 0 0.3" size="0.005"/>
    </body>
  </worldbody>
</mujoco>
